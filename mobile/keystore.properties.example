# Copy to keystore.properties and fill in. Never commit the real file.
#
# Create a keystore once, and keep it somewhere safe — losing it means you can
# never update an app already installed from it:
#
#   keytool -genkey -v -keystore spyrent-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias spyrent
#
storeFile=../spyrent-release.jks
storePassword=
keyAlias=spyrent
keyPassword=
