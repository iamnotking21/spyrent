<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="top"
    android:padding="16dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/webtextview2"
                android:layout_width="113dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/kindi"
                android:gravity="center"
                android:textColor="@color/item"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:textSize="16dp"
                android:text="Child Name : "
                android:textStyle="bold" />
            <TextView
                android:id="@+id/webtextview1"
                android:layout_width="113dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/kindi"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:gravity="center"
                android:textColor="@color/item"
                android:textSize="16dp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/editbutton8"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:textSize="17dp"
                android:layout_marginBottom="5dp"
                android:textStyle="bold"
                android:text="Edit Name"
                android:background="@drawable/rdb"
                android:textColor="@color/item"
                android:fontFamily="@font/kindi"
                android:layout_marginTop="5dp"
                />

            <Button
                android:id="@+id/delbutton10"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:layout_marginLeft="5dp"
                android:textSize="18dp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/rdb_red"
                android:textColor="@color/item"
                android:fontFamily="@font/kindi"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="73dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image1"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:srcCompat="@drawable/blockingandtimelabel1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/apps"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Application"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/item"
                android:background="@drawable/rdb"
                android:fontFamily="@font/kindi"/>



           <Button
               android:id="@+id/websites"
               android:layout_width="106dp"
               android:layout_height="wrap_content"
               android:text="Websites"
               android:layout_marginBottom="5dp"
               android:layout_marginTop="5dp"
               android:textStyle="bold"
               android:layout_marginLeft="5dp"
               android:background="@drawable/rdb"

               android:fontFamily="@font/kindi"
               android:textColor="@color/item"
               android:textSize="18dp"/>
            </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/image2"
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                app:srcCompat="@drawable/viewhistory1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

           <Button
               android:id="@+id/history_app"
               android:layout_width="125dp"
               android:layout_height="wrap_content"
               android:text="Sites History"
               android:layout_marginBottom="5dp"
               android:background="@drawable/rdb"
               android:fontFamily="@font/kindi"
               android:layout_marginTop="5dp"
               android:textColor="@color/item"
               android:textStyle="bold"
               android:textSize="16dp" />

           <Button
               android:id="@+id/history_sites"
               android:layout_width="125dp"
               android:layout_marginBottom="5dp"
               android:layout_height="wrap_content"
               android:textColor="@color/item"
               android:layout_marginTop="5dp"
               android:text="Apps History"
               android:layout_marginLeft="5dp"
               android:textStyle="bold"
               android:background="@drawable/rdb"
               android:fontFamily="@font/kindi"
               android:textSize="16dp" />
       </LinearLayout>
    </LinearLayout>



</LinearLayout>