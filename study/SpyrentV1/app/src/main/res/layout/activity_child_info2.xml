<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context="com.example.spyrentv1.ChildInfo">

    <Button
        android:id="@+id/blockapp"
        android:layout_width="241dp"
        android:layout_height="127dp"
        android:layout_marginTop="196dp"
        android:background="@drawable/rdb"
        android:text="Block App"
        android:textColor="@color/item"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="30dp"
        app:layout_constraintHorizontal_bias="0.465"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/blocksite"
        android:layout_width="241dp"
        android:layout_height="120dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/rdb"
        android:text="Block site"
        android:textColor="@color/item"
        android:textSize="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.464"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blockapp" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="93dp"

        android:layout_height="30dp"
        android:layout_marginTop="96dp"
        android:text="Child name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>